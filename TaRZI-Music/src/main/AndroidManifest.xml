<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name="com.antigravity.shieldx.music.MusicApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_tarzi_music"
        android:label="@string/music_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TaRZIMusic">

        <activity
            android:name="com.antigravity.shieldx.ui.music.MusicActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TaRZIMusic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- How another app (including TaRZI's assistant) asks for a song -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.antigravity.tarzi.music.action.PLAY_QUERY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Native Media3 Music Playback Service -->
        <service
            android:name="com.antigravity.shieldx.music.MusicPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
