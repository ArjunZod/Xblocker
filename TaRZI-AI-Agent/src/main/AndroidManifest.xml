<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Always-on voice, floating orb, screen vision -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Device control tools -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Finds and drives the separately installed TaRZI Music app -->
    <queries>
        <package android:name="com.antigravity.tarzi.music" />
        <package android:name="com.antigravity.tarzi.music.debug" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name="com.antigravity.shieldx.assistant.AgentApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_tarzi_agent"
        android:label="@string/agent_app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TaRZIAgent">

        <activity
            android:name="com.antigravity.shieldx.ui.assistant.AgentActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TaRZIAgent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Let the user bind this to the system assistant gesture -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- System-wide sight and control -->
        <service
            android:name="com.antigravity.shieldx.assistant.system.TarziAccessibilityService"
            android:exported="true"
            android:label="@string/agent_app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/tarzi_accessibility_config" />
        </service>

        <!-- Always-on wake word and voice loop -->
        <service
            android:name="com.antigravity.shieldx.assistant.system.TarziVoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Screen sharing: lets Tarzi see pixels, not just element text -->
        <service
            android:name="com.antigravity.shieldx.assistant.system.ScreenVisionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Floating Tarzi orb drawn over other apps -->
        <service
            android:name="com.antigravity.shieldx.assistant.system.TarziOverlayService"
            android:exported="false" />
    </application>

</manifest>
