<?xml version="1.0" encoding="utf-8"?>
<!--
    A solid accent field. No gradient, no bloom, no ring.

    Launcher icons are read at ~48dp among dozens of others: a flat, saturated
    ground with one high-contrast shape is what stays recognisable at that size,
    which is exactly what the previous gradient-and-ring mark lost.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#5B59D6" />
</vector>
